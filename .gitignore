/data/unstructured/
*.parquet
*.pptx
*.docx
*.xlsx
# ── ML artifacts — managed by registry, not by git ───────────────────────────
*.joblib
*.pkl
/artifacts/

# ── Secrets — NEVER commit ───────────────────────────────────────────────────
.env
*.key
*.pem

# ── IDE ───────────────────────────────────────────────────────────────────────
