# ─────────────────────────────────────────────────────────────────────────────
# FEM Surrogate ML Platform — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_REGION=us-east-1

# Bucket names (created automatically by minio-setup service on first start)
MINIO_BUCKET_RAW=raw-simulations
MINIO_BUCKET_PROCESSED=processed-simulations
MINIO_BUCKET_FEATURES=features
MINIO_BUCKET_ARTIFACTS=ml-artifacts

# ── PostgreSQL (MLflow backend store) ─────────────────────────────────────────
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change_me_in_production

# ── MLflow ────────────────────────────────────────────────────────────────────
# Internal service name (used by API and training containers)
MLFLOW_TRACKING_URI=http://mlflow:5000
# Override when running training locally pointing to docker-compose stack:
# MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fem-surrogate

# S3 / MinIO credentials for MLflow artifact storage
# (same as MINIO_ROOT_USER/PASSWORD — kept separate for clarity)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me_in_production
AWS_DEFAULT_REGION=us-east-1
# Use http://localhost:9000 when running training from the host machine (outside Docker).
# Inside Docker containers the service is reachable as http://minio:9000.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# ── Model serving (API container) ────────────────────────────────────────────
# Path inside the api container (artifacts/ is mounted as a volume)
MODEL_DIR=/app/artifacts/models/lgbm_surrogate/latest
MODEL_NAME=lgbm_surrogate
REGISTRY_DIR=/app/artifacts/models
API_LOG_LEVEL=INFO
API_USERNAME=admin
API_PASSWORD=change_me_in_production

# ── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production
